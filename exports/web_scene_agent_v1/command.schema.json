{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Isaac scene agent instruction v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": "web_scene_agent/1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "op": {
          "const": "scene.describe"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "request_id",
        "op",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": "web_scene_agent/1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "op": {
          "const": "datasets.list"
        },
        "args": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "request_id",
        "op",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": "web_scene_agent/1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "op": {
          "const": "scene.patch"
        },
        "args": {
          "type": "object",
          "properties": {
            "profile": {
              "const": "isaac32_fixed_base_pickplace"
            },
            "rooms": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true
            },
            "changes": {
              "type": "object",
              "properties": {
                "robot_base_pose": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "tray_pose": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "robot_color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "tray_color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "required": [],
              "additionalProperties": false,
              "minProperties": 1
            }
          },
          "required": [
            "profile",
            "rooms",
            "changes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "request_id",
        "op",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": "web_scene_agent/1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "op": {
          "const": "training.plan"
        },
        "args": {
          "type": "object",
          "properties": {
            "dataset_ids": {
              "type": "array",
              "items": {
                "enum": [
                  "isaac32_narrow_20261016",
                  "isaac32_wide_20261016"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "model": {
              "const": "pi05_lora"
            },
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "dataset_ids",
            "model",
            "steps",
            "batch_size",
            "seed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "request_id",
        "op",
        "args"
      ],
      "additionalProperties": false
    }
  ]
}
